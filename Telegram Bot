<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MINO SMS PANEL - LIVE DASHBOARD</title>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/vue/3.3.4/vue.global.prod.min.js"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script src="https://cdn.tailwindcss.com"></script>

  <script>
    document.addEventListener('contextmenu', e => e.preventDefault());
    document.addEventListener('keydown', e => {
      const target = e.target.tagName.toLowerCase();
      const isInput = target === 'input' || target === 'textarea';
      if (e.keyCode === 123) e.preventDefault();
      if (e.ctrlKey && e.shiftKey && (e.keyCode === 73 || e.keyCode === 67 || e.keyCode === 74)) e.preventDefault();
      if (e.ctrlKey && e.keyCode === 85) e.preventDefault();
      if (e.ctrlKey && e.keyCode === 67 && !isInput) e.preventDefault();
      if (e.ctrlKey && e.keyCode === 65 && !isInput) e.preventDefault();
    });
  </script>
  
  <style>
    [v-cloak] { display: none !important; }
    body { background-color: #F8FAFC; }
    
    @keyframes slideUp {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes popIn {
      0% { opacity: 0; transform: scale(0.96); }
      100% { opacity: 1; transform: scale(1); }
    }
    @keyframes pulseGlow {
      0%, 100% { box-shadow: 0 0 10px rgba(16, 185, 129, 0.4); border-color: #10b981; }
      50% { box-shadow: 0 0 20px rgba(16, 185, 129, 0.8); border-color: #059669; }
    }
    @keyframes beaconPulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.3; transform: scale(1.3); }
    }
    @keyframes toastProgress {
      from { width: 100%; }
      to { width: 0%; }
    }

    .page-enter-active { animation: slideUp 0.25s ease-out forwards; }
    .pop-in { animation: popIn 0.2s ease-out forwards; }
    .otp-hit-glow { animation: pulseGlow 1.2s infinite ease-in-out; }
    .beacon-dot { animation: beaconPulse 1.5s infinite ease-in-out; }
    .toast-progress-bar { animation: toastProgress 2.8s linear forwards; }
    
    .hover-card {
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .hover-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 16px -4px rgba(99, 102, 241, 0.12);
    }

    .toast-enter-active, .toast-leave-active {
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .toast-enter-from {
      opacity: 0;
      transform: translateY(-15px) scale(0.95);
    }
    .toast-leave-to {
      opacity: 0;
      transform: translateY(-10px) scale(0.95);
    }
  </style>
</head>
<body class="text-slate-700 font-sans select-none pb-4 md:pb-0">

  <div id="app" v-cloak>

    <!-- 🔔 COMPACT NOTIFICATION TOAST WITH PURPLE BOTTOM PROGRESS LINE -->
    <transition name="toast">
      <div v-if="showToast" class="fixed top-4 right-3 sm:right-6 z-[99999] max-w-xs w-full select-none">
        <div class="relative bg-white rounded-xl p-2.5 shadow-xl border border-slate-100 flex items-center justify-between gap-2.5 overflow-hidden">
          
          <!-- Purple Bottom Progress Bar -->
          <div class="absolute bottom-0 left-0 h-1 bg-purple-600 toast-progress-bar"></div>

          <!-- Left Accent Bar -->
          <div class="absolute left-0 top-0 bottom-0 w-1 bg-emerald-500 rounded-l-xl"></div>

          <div class="flex items-center gap-2.5 pl-1 flex-1 min-w-0">
            <div class="h-7 w-7 rounded-xl bg-emerald-100 flex items-center justify-center shrink-0">
              <i class="fa-solid fa-check text-emerald-600 text-xs font-black"></i>
            </div>
            
            <div class="flex flex-col min-w-0">
              <span class="font-bold text-slate-800 text-xs leading-tight truncate">
                {{ toastTitle }}
              </span>
              <span class="text-[10px] font-semibold text-slate-500 mt-0.5 truncate leading-tight">
                {{ toastMessage }}
              </span>
            </div>
          </div>

          <button @click="showToast = false" class="h-6 w-6 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-400 hover:text-slate-600 flex items-center justify-center transition shrink-0">
            <i class="fa-solid fa-xmark text-[10px]"></i>
          </button>
        </div>
      </div>
    </transition>

    <!-- Auth Screen -->
    <div v-if="!user" class="min-h-screen flex items-center justify-center p-4">
      <div class="bg-white p-6 sm:p-8 rounded-3xl border border-slate-200 shadow-sm max-w-md w-full space-y-6 pop-in">
        <div class="text-center space-y-2">
          <span class="px-4 py-1.5 bg-gradient-to-r from-indigo-600 to-indigo-800 rounded-2xl flex items-center justify-center text-white font-black text-lg mx-auto shadow-md w-max">MINO</span>
          <h1 class="text-xl font-black text-slate-900">MINO SMS PANEL</h1>
          <p class="text-[10px] font-semibold text-indigo-600 uppercase tracking-widest">{{ isRegistering ? 'Register Account' : 'Sign in to network' }}</p>
        </div>

        <div class="flex bg-slate-100 p-1.5 rounded-2xl font-bold">
          <button type="button" @click="isRegistering = false" :class="!isRegistering ? 'bg-white text-indigo-600 shadow-sm' : 'text-slate-500 hover:text-slate-800'" class="flex-1 font-bold py-2.5 rounded-xl text-xs transition">
            LOG IN
          </button>
          <button type="button" @click="isRegistering = true" :class="isRegistering ? 'bg-white text-indigo-600 shadow-sm' : 'text-slate-500 hover:text-slate-800'" class="flex-1 font-bold py-2.5 rounded-xl text-xs transition">
            CREATE ACCOUNT
          </button>
        </div>

        <form @submit.prevent="handleAuth" class="space-y-4">
          <div v-if="isRegistering">
            <label class="text-xs font-bold text-slate-500">Your Name</label>
            <input type="text" required v-model="authName" placeholder="Name" class="w-full mt-1.5 p-3.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-semibold outline-none focus:border-indigo-600 transition" />
          </div>
          <div>
            <label class="text-xs font-bold text-slate-500">Email Address</label>
            <input type="email" required v-model="authEmail" placeholder="user@network.com" class="w-full mt-1.5 p-3.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-semibold outline-none focus:border-indigo-600 transition" />
          </div>
          <div>
            <label class="text-xs font-bold text-slate-500">Password</label>
            <input type="password" required v-model="authPassword" placeholder="••••••••" class="w-full mt-1.5 p-3.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-semibold outline-none focus:border-indigo-600 transition" />
          </div>
          
          <div v-if="isRegistering">
            <label class="text-xs font-bold text-slate-500">Agent Email (Optional - Defaults to Official Agent)</label>
            <input type="email" v-model="authAgentEmail" placeholder="official@minosms.xyz (Optional)" class="w-full mt-1.5 p-3.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-semibold outline-none focus:border-indigo-600 transition" />
          </div>

          <button type="submit" :disabled="authLoading" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3.5 rounded-xl text-sm shadow-md transition disabled:bg-slate-300 cursor-pointer">
            {{ authLoading ? 'Please wait...' : (isRegistering ? 'REGISTER ACCOUNT' : 'LOG IN NOW') }}
          </button>
        </form>

        <div class="text-center">
          <button type="button" @click="isRegistering = !isRegistering" class="text-xs font-semibold text-indigo-600 hover:underline cursor-pointer">
            {{ isRegistering ? 'Already have an account? Log In' : "Don't have an account? Create One" }}
          </button>
        </div>
      </div>
    </div>

    <!-- Main Portal Interface Layout -->
    <div v-else class="min-h-screen flex flex-col md:flex-row bg-[#F8FAFC]">
      
      <!-- Sidebar Navigation -->
      <aside class="hidden md:flex w-64 bg-white border-r border-slate-200 flex-col shrink-0 select-none">
        <div class="p-6 border-b border-slate-100 flex items-center justify-between">
          <div class="flex items-center gap-3">
            <span class="px-2 py-1 bg-gradient-to-r from-[#0088CC] to-[#0077b5] rounded-lg flex items-center justify-center text-white font-black text-sm">MINO</span>
            <span class="text-lg font-black text-slate-900 font-bold">MINO SMS</span>
          </div>
          <span class="flex h-2.5 w-2.5 relative" title="Live Sync Active">
            <span class="beacon-dot absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
          </span>
        </div>

        <nav class="flex-1 p-4 space-y-1 overflow-y-auto">
          <div class="space-y-1">
            <span class="px-4 text-[9px] uppercase font-black text-indigo-600 tracking-wider block mb-2">User Workspace</span>
            
            <button @click="currentTab = 'dashboard'" :class="currentTab === 'dashboard' ? 'bg-indigo-50 text-indigo-600 border-l-2 border-indigo-600' : 'text-slate-600 hover:bg-slate-50'" class="w-full flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-semibold transition text-left">
              <i class="fa-solid fa-house"></i> Dashboard
            </button>
            
            <button @click="currentTab = 'get-number'" :class="currentTab === 'get-number' ? 'bg-indigo-50 text-indigo-600 border-l-2 border-indigo-600' : 'text-slate-600 hover:bg-slate-50'" class="w-full flex items-center justify-between px-4 py-3 rounded-xl text-sm font-semibold transition text-left">
              <span class="flex items-center gap-3"><i class="fa-solid fa-mobile-screen"></i> Get Number</span>
              <span v-if="activeAllocationsCount > 0" class="px-2 py-0.5 bg-emerald-500 text-white rounded-full text-[9px] font-black animate-pulse">
                {{ activeAllocationsCount }}
              </span>
            </button>
            
            <button @click="currentTab = 'console'" :class="currentTab === 'console' ? 'bg-indigo-50 text-indigo-600 border-l-2 border-indigo-600' : 'text-slate-600 hover:bg-slate-50'" class="w-full flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-semibold transition text-left">
              <i class="fa-solid fa-terminal"></i> Console
            </button>

            <button @click="currentTab = 'live-access'" :class="currentTab === 'live-access' ? 'bg-indigo-50 text-indigo-600 border-l-2 border-indigo-600' : 'text-slate-600 hover:bg-slate-50'" class="w-full flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-semibold transition text-left font-bold">
              <i class="fa-solid fa-satellite-dish text-emerald-500"></i> Live Access
            </button>

            <button @click="currentTab = 'summary'" :class="currentTab === 'summary' ? 'bg-indigo-50 text-indigo-600 border-l-2 border-indigo-600' : 'text-slate-600 hover:bg-slate-50'" class="w-full flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-semibold transition text-left">
              <i class="fa-solid fa-square-poll-vertical"></i> Summary
            </button>

            <button @click="currentTab = 'leaderboard'" :class="currentTab === 'leaderboard' ? 'bg-indigo-50 text-indigo-600 border-l-2 border-indigo-600' : 'text-slate-600 hover:bg-slate-50'" class="w-full flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-semibold transition text-left">
              <i class="fa-solid fa-trophy"></i> Leaderboard
            </button>
          </div>

          <span class="px-4 text-[9px] uppercase font-black text-slate-400 tracking-wider block pt-4 mb-2">Account & Tools</span>
          <button @click="currentTab = 'payment'" :class="currentTab === 'payment' ? 'bg-indigo-50 text-indigo-600 border-l-2 border-indigo-600' : 'text-slate-600 hover:bg-slate-50'" class="w-full flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-semibold transition text-left">
            <i class="fa-solid fa-wallet"></i> Withdraw
          </button>
          <button @click="currentTab = 'profile'" :class="currentTab === 'profile' ? 'bg-indigo-50 text-indigo-600 border-l-2 border-indigo-600' : 'text-slate-600 hover:bg-slate-50'" class="w-full flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-semibold transition text-left">
            <i class="fa-solid fa-user"></i> Profile
          </button>

          <div class="pt-2 px-2">
            <button @click="currentTab = 'api-docs'" :class="currentTab === 'api-docs' ? 'bg-indigo-600 text-white' : 'bg-indigo-50 text-indigo-600'" class="w-full hover:bg-indigo-100 font-bold py-3 px-4 rounded-2xl text-xs flex justify-between items-center shadow-xs transition active:scale-[0.97]">
              <span class="flex items-center gap-2">
                <i class="fa-solid fa-code text-sm"></i> Are you developer
              </span>
              <i class="fa-solid fa-chevron-right text-[10px]"></i>
            </button>
          </div>
        </nav>

        <div class="p-4 border-t border-slate-100 flex items-center gap-3 select-none">
          <div class="h-9 w-9 bg-indigo-600 rounded-full flex items-center justify-center text-white font-bold text-sm shrink-0">
            {{ user?.name ? user.name.slice(0, 2).toUpperCase() : 'US' }}
          </div>
          <div class="flex-1 overflow-hidden">
            <p class="text-xs font-black text-slate-800 truncate">{{ user?.name || 'User' }}</p>
            <p class="text-[10px] text-slate-400 truncate">{{ user?.email }}</p>
          </div>
          <button @click="signOut" class="text-slate-400 hover:text-rose-600 transition"><i class="fa-solid fa-right-from-bracket"></i></button>
        </div>
      </aside>

      <!-- Mobile Drawer -->
      <transition enter-active-class="transition ease-out duration-300" enter-from-class="-translate-x-full" enter-to-class="translate-x-0" leave-active-class="transition ease-in duration-200" leave-from-class="translate-x-0" leave-to-class="-translate-x-full">
        <aside v-if="mobileMenuOpen" class="fixed inset-y-0 left-0 w-64 bg-white text-slate-700 flex flex-col z-50 md:hidden shadow-2xl border-r border-slate-200 select-none">
          <div class="p-6 border-b border-slate-100 flex items-center justify-between bg-slate-50">
            <div class="flex items-center gap-3">
              <span class="px-2 py-1 bg-indigo-600 rounded flex items-center justify-center text-white font-black text-xs font-bold">MINO</span>
              <span class="text-md font-black text-slate-900 font-bold">MINO SMS</span>
            </div>
            <button @click="mobileMenuOpen = false" class="text-slate-400 hover:text-slate-800"><i class="fa-solid fa-xmark text-lg"></i></button>
          </div>

          <nav class="flex-1 p-4 space-y-1 bg-white overflow-y-auto">
            <div class="space-y-1">
              <span class="px-4 text-[9px] uppercase font-black text-indigo-600 tracking-wider block mb-2">User Workspace</span>
              <button @click="navigateMobile('dashboard')" :class="currentTab === 'dashboard' ? 'bg-indigo-50 text-indigo-600' : 'hover:bg-slate-50'" class="w-full flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-semibold transition text-left font-bold">
                <i class="fa-solid fa-house"></i> Dashboard
              </button>
              <button @click="navigateMobile('get-number')" :class="currentTab === 'get-number' ? 'bg-indigo-50 text-indigo-600' : 'hover:bg-slate-50'" class="w-full flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-semibold transition text-left font-bold">
                <i class="fa-solid fa-mobile-screen"></i> Get Number
              </button>
              <button @click="navigateMobile('console')" :class="currentTab === 'console' ? 'bg-indigo-50 text-indigo-600' : 'hover:bg-slate-50'" class="w-full flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-semibold transition text-left font-bold">
                <i class="fa-solid fa-terminal"></i> Console
              </button>
              <button @click="navigateMobile('live-access')" :class="currentTab === 'live-access' ? 'bg-indigo-50 text-indigo-600 border-l-2 border-indigo-600' : 'text-slate-600 hover:bg-slate-50'" class="w-full flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-semibold transition text-left font-bold">
                <i class="fa-solid fa-satellite-dish text-emerald-500"></i> Live Access
              </button>
              <button @click="navigateMobile('summary')" :class="currentTab === 'summary' ? 'bg-indigo-50 text-indigo-600 border-l-2 border-indigo-600' : 'text-slate-600 hover:bg-slate-50'" class="w-full flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-semibold transition text-left font-bold">
                <i class="fa-solid fa-square-poll-vertical"></i> Summary
              </button>
              <button @click="navigateMobile('leaderboard')" :class="currentTab === 'leaderboard' ? 'bg-indigo-50 text-indigo-600 border-l-2 border-indigo-600' : 'text-slate-600 hover:bg-slate-50'" class="w-full flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-semibold transition text-left font-bold">
                <i class="fa-solid fa-trophy"></i> Leaderboard
              </button>
            </div>

            <span class="px-4 text-[9px] uppercase font-black text-slate-400 tracking-wider block pt-4 mb-2">Account & Tools</span>
            <button @click="navigateMobile('payment')" :class="currentTab === 'payment' ? 'bg-indigo-50 text-indigo-600 border-l-2 border-indigo-600' : 'text-slate-600 hover:bg-slate-50'" class="w-full flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-semibold transition text-left">
              <i class="fa-solid fa-wallet"></i> Withdraw
            </button>
            <button @click="navigateMobile('profile')" :class="currentTab === 'profile' ? 'bg-indigo-50 text-indigo-600' : 'hover:bg-slate-50'" class="w-full flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-semibold transition text-left md:font-bold">
              <i class="fa-solid fa-user"></i> Profile
            </button>

            <div class="pt-2 px-2 select-none">
              <button @click="navigateMobile('api-docs')" :class="currentTab === 'api-docs' ? 'bg-indigo-600 text-white' : 'bg-indigo-50 text-indigo-600'" class="w-full hover:bg-indigo-100 font-bold py-3 px-4 rounded-2xl text-xs flex justify-between items-center shadow-xs transition active:scale-[0.97]">
                <span class="flex items-center gap-2">
                  <i class="fa-solid fa-code text-sm"></i> Are you developer
                </span>
                <i class="fa-solid fa-chevron-right text-[10px]"></i>
              </button>
            </div>
          </nav>

          <div class="p-4 border-t border-slate-200 bg-slate-50 text-xs font-bold flex flex-col gap-3">
            <a href="https://t.me/MinoXSupport0" target="_blank" class="flex items-center gap-2 text-indigo-600 hover:underline">
              <i class="fa-brands fa-telegram text-base"></i> Telegram Support
            </a>
            <div class="flex items-center justify-between border-t border-slate-200 pt-3">
              <span class="text-slate-808 font-bold">{{ user?.name || 'User' }}</span>
              <button @click="signOut" class="text-rose-500 hover:text-rose-700 transition font-bold">LOGOUT</button>
            </div>
          </div>
        </aside>
      </transition>
      
      <div v-if="mobileMenuOpen" @click="mobileMenuOpen = false" class="fixed inset-0 bg-black/40 backdrop-blur-xs z-40 md:hidden"></div>

      <!-- Main Content Area -->
      <main class="flex-1 p-4 md:p-8 space-y-6 overflow-y-auto">
        
        <header class="flex justify-between items-center border-b border-slate-200 pb-4 select-none">
          <div class="flex items-center gap-3">
            <button @click="mobileMenuOpen = true" class="md:hidden text-slate-700 bg-white shadow-xs border p-2.5 rounded-xl focus:outline-none transition active:scale-95">
              <i class="fa-solid fa-bars text-lg"></i>
            </button>
            <span class="h-2.5 w-2.5 bg-indigo-600 rounded-full hidden md:inline-block"></span>
            <h2 class="text-md md:text-lg font-black text-slate-900 capitalize font-bold">
              {{ currentTab.replace('-', ' ') }}
            </h2>
          </div>
          
          <div class="flex items-center gap-3">
            <span class="bg-emerald-50 text-emerald-700 border border-emerald-200 text-[10px] md:text-xs font-bold px-3 py-1.5 rounded-full shadow-xs flex items-center gap-2">
              <span class="h-2 w-2 rounded-full bg-emerald-500 beacon-dot"></span>
              <span class="hidden sm:inline">LIVE SYNC ON</span>
            </span>
            
            <span class="bg-indigo-600 text-white text-[10px] md:text-xs font-bold px-3 py-1.5 rounded-full shadow-sm font-semibold">
              {{ user?.name }}
            </span>
            <button @click="signOut" class="hidden md:block text-slate-400 hover:text-rose-600 p-2 transition"><i class="fa-solid fa-right-from-bracket text-lg"></i></button>
          </div>
        </header>

        <div v-if="announcement" class="bg-indigo-50 border border-indigo-200 text-indigo-800 px-5 py-3 rounded-2xl text-xs font-bold flex items-center gap-2 select-none font-semibold shadow-2xs">
          <i class="fa-solid fa-bullhorn text-[#0088CC] text-sm animate-bounce"></i>
          <span>{{ announcement }}</span>
        </div>

        <div>

          <!-- User Tab 1: Dashboard -->
          <div v-if="currentTab === 'dashboard'" class="page-enter-active space-y-6 select-none">
            <div>
              <h3 class="text-[10px] md:text-xs font-bold text-slate-400 uppercase tracking-widest mb-4">WALLET & REPORT</h3>
              <div class="grid grid-cols-2 md:grid-cols-3 gap-3 md:gap-4 font-semibold">
                
                <div class="bg-white p-4 md:p-5 rounded-2xl border border-slate-200 shadow-xs flex flex-col md:flex-row items-start md:items-center gap-3 hover-card">
                  <div class="bg-indigo-50 h-10 w-10 rounded-xl flex items-center justify-center text-indigo-600 shrink-0"><i class="fa-solid fa-wallet text-md"></i></div>
                  <div>
                    <p class="text-[10px] text-slate-400 font-bold">Balance</p>
                    <h4 class="text-sm md:text-lg font-bold text-slate-800 mt-0.5 font-mono font-bold">৳ {{ parseFloat(profile ? profile.balance : 0).toFixed(2) }}</h4>
                  </div>
                </div>

                <div class="bg-white p-4 md:p-5 rounded-2xl border border-slate-200 shadow-xs flex flex-col md:flex-row items-start md:items-center gap-3 hover-card">
                  <div class="bg-emerald-50 h-10 w-10 rounded-xl flex items-center justify-center text-emerald-600 shrink-0"><i class="fa-solid fa-tag text-md"></i></div>
                  <div>
                    <p class="text-[10px] text-slate-400 font-bold">Base OTP Rate</p>
                    <h4 class="text-sm md:text-lg font-bold text-slate-800 mt-0.5 font-mono font-bold">৳ {{ parseFloat(profile ? profile.otp_rate : 0.40).toFixed(2) }}</h4>
                  </div>
                </div>

                <div class="bg-white p-4 md:p-5 rounded-2xl border border-slate-200 shadow-xs flex flex-col md:flex-row items-start md:items-center gap-3 col-span-2 md:col-span-1 hover-card">
                  <div class="bg-blue-50 h-10 w-10 rounded-xl flex items-center justify-center text-blue-600 shrink-0"><i class="fa-solid fa-box text-md"></i></div>
